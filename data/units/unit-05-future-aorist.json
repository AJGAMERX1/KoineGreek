   ],
   "rule": {
    "title": "Add a σ",
    "body": "Future = present endings with σ before them: λύ-σ-ω, λύ-σ-εις. Consonant stems combine: βλέπω → βλέψω, ἄγω → ἄξω, βαπτίζω → βαπτίσω. Liquid stems (λ μ ν ρ) drop the σ and take a circumflex: ἀποστέλλω → ἀποστελῶ, ἐγείρω → ἐγερῶ, κρίνω → κρινῶ. Some verbs are middle in the future only: ἔσομαι, γνώσομαι, ὄψομαι.",
    "examples": [
     {
      "gr": "σώσει τὸν λαὸν αὐτοῦ",
      "en": "he will save his people"
     },
     {
      "gr": "ἐγερῶ αὐτόν",
      "en": "I will raise him"
     },
     {
      "gr": "ὄψεσθε",
      "en": "you will see"
     }
    ]
   },
