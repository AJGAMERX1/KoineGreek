  {
   "id": "u05-aorist-2",
   "type": "verb",
   "label": "εἶπον",
   "sub": "The second aorist",
   "drills": [
    "gloss-mc",
    "gloss-type",
    "form-recognition",
    "parse",
    "supply-form",
    "principal-parts"
   ],
   "rule": {
    "title": "A new stem, old endings",
    "body": "Many common verbs form the aorist on a shorter root and use imperfect-style endings: λέγω → εἶπον, ἔρχομαι → ἦλθον, ὁράω → εἶδον, λαμβάνω → ἔλαβον, γίνομαι → ἐγενόμην, βάλλω → ἔβαλον. Meaning is identical to the first aorist. The stem must be memorized as vocabulary: that is why the strange-verb drills exist.",
    "examples": [
     {
      "gr": "εἶπεν αὐτοῖς ὁ Ἰησοῦς",
      "en": "Jesus said to them"
     },
     {
      "gr": "ἦλθεν εἰς τὴν Γαλιλαίαν",
      "en": "he came into Galilee"
     },
     {
      "gr": "καὶ ἐγένετο",
      "en": "and it came to pass"
     }
    ]
   },
   "vocab": [],
   "paradigms": [
    "aor2-act",
    "aor2-mid",
    "infinitives-aor2"
   ]
  },
  {
   "id": "u05-aorist-passive",
   "type": "verb",
   "label": "ἐλύθην",
   "sub": "Aorist and future passive",
   "drills": [
    "gloss-mc",
    "gloss-type",
    "form-recognition",
    "parse",
    "supply-form",
    "principal-parts"
   ],
   "rule": {
    "title": "θη means passive",
    "body": "Augment + θη + active-looking endings: ἐλύθην, ἐλύθης, ἐλύθη, ἐλύθημεν, ἐλύθητε, ἐλύθησαν; future λυθήσομαι. A handful of deponents use the aorist passive with active meaning: ἀπεκρίθη he answered, ἐπορεύθη he went, ἐφοβήθησαν they were afraid. The agent of a passive is ὑπό + genitive.",
    "examples": [
     {
      "gr": "ἐβαπτίσθη ὑπὸ Ἰωάννου",
      "en": "he was baptized by John"
     },
     {
      "gr": "ἠγέρθη",
      "en": "he was raised"
     },
     {
      "gr": "ἀπεκρίθη αὐτῷ",
      "en": "he answered him"
     }
    ]
   },
   "vocab": [],
   "paradigms": [
    "aor-pass",
    "fut-pass"
   ]
  },
