   "rule": {
    "title": "The glue of Greek sentences",
    "body": "Greek writers rarely start a sentence without a connector: καί, δέ, γάρ, οὖν. μέν … δέ … pairs two halves ('on the one hand … on the other'). δέ, γάρ, οὖν and μέν are 'postpositive': they sit second in the sentence but translate first. ὅταν = ὅτε + ἄν, 'whenever'; ἐάν = εἰ + ἄν, 'if ever'.",
    "examples": [
     {
      "gr": "ὁ μὲν … ὁ δὲ …",
      "en": "the one … the other …"
     },
     {
      "gr": "ὥστε",
      "en": "so that, with the result that"
     },
     {
      "gr": "οὔτε … οὔτε …",
      "en": "neither … nor …"
     }
    ]
   },
