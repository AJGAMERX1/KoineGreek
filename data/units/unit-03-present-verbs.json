   "rule": {
    "title": "Vowels that merge",
    "body": "When a stem ends in ε, it merges with the ending: ποιέ-ω → ποιῶ, ποιέ-εις → ποιεῖς, ποιέ-ομεν → ποιοῦμεν. The circumflex is the scar. Dictionaries list the uncontracted form (ποιέω) so you can see the stem; the text never does.",
    "examples": [
     {
      "gr": "τί ποιεῖτε;",
      "en": "what are you doing?"
     },
     {
      "gr": "λαλεῖ ὁ Ἰησοῦς",
      "en": "Jesus is speaking"
     },
     {
      "gr": "ζητοῦμεν τὴν βασιλείαν",
      "en": "we seek the kingdom"
     }
    ]
   },
