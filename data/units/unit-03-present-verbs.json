   "rule": {
    "title": "Who, which, someone, no one",
    "body": "ὅς ἥ ὅ (who / which) agrees with its antecedent in gender and number but takes its case from its own clause. τίς with an accent asks a question; τις without one means 'someone, a certain'. οὐδείς / μηδείς = 'no one, nothing', declined like εἷς.",
    "examples": [
     {
      "gr": "ὁ ἄνθρωπος ὃν εἶδες",
      "en": "the man whom you saw"
     },
     {
      "gr": "τίς ἐστιν οὗτος;",
      "en": "who is this?"
     },
     {
      "gr": "οὐδεὶς ἀγαθὸς εἰ μὴ εἷς ὁ θεός",
      "en": "no one is good except one: God"
     }
    ]
