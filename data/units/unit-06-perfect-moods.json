  {
   "id": "u06-subjunctive",
   "type": "verb",
   "label": "λύω λύσω",
   "sub": "The subjunctive mood",
   "drills": [
    "gloss-mc",
    "gloss-type",
    "form-recognition",
    "parse",
    "supply-form",
    "principal-parts"
   ],
   "rule": {
    "title": "Long vowels, open possibilities",
    "body": "The subjunctive lengthens the connecting vowel (ω, ῃ, ῃ, ωμεν, ητε, ωσι). It appears after ἵνα (in order that), ἐάν (if), ὅταν (whenever), in exhortations (ἀγαπῶμεν, let us love), in deliberative questions (τί ποιήσωμεν; what should we do?), and in emphatic denials (οὐ μή + aorist subjunctive). Aorist vs present subjunctive is a difference of aspect, not time.",
    "examples": [
     {
      "gr": "ἵνα πιστεύητε",
      "en": "so that you may believe"
     },
     {
      "gr": "ἐὰν εἴπωμεν",
      "en": "if we say"
     },
     {
      "gr": "οὐ μὴ ἀπόλωνται",
      "en": "they will certainly not perish"
     }
    ]
   },
