   "rule": {
    "title": "Done, and still true",
    "body": "Reduplicate (λε-λυ-) and add κα: λέλυκα, λέλυκας, λέλυκε(ν), λελύκαμεν, λελύκατε, λελύκασι(ν). The perfect describes a completed act whose result is present: γέγραπται, it stands written; ἐλήλυθεν, he has come (and is here). Verbs beginning with a vowel lengthen instead of reduplicating (ἀκούω → ἀκήκοα).",
    "examples": [
     {
      "gr": "γέγραπται",
      "en": "it is written"
     },
     {
      "gr": "πεπιστεύκαμεν",
      "en": "we have believed / we are convinced"
     },
     {
      "gr": "ἑώρακα τὸν κύριον",
      "en": "I have seen the Lord"
     }
    ]
