    "supply-form",
    "principal-parts"
   ],
   "rule": {
    "title": "Commands and prohibitions",
    "body": "Present imperative (λῦε, λύετε) = keep doing / make a habit; aorist imperative (λῦσον, λύσατε) = do it. Third-person imperatives (-τω, -τωσαν) mean 'let him / let them'. To forbid: μή + present imperative (stop doing) or μή + aorist subjunctive (don't do).",
    "examples": [
     {
      "gr": "ἀκολούθει μοι",
      "en": "follow me (and keep following)"
     },
     {
      "gr": "ἄρον τὸν κράβαττόν σου",
      "en": "pick up your mat"
     },
     {
      "gr": "μὴ φοβοῦ",
      "en": "do not be afraid"
     }
    ]
   },
