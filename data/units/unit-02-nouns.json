      "gr": "τὸ εὐαγγέλιον τῆς βασιλείας",
      "en": "the gospel of the kingdom"
     },
     {
      "gr": "τὰ τέκνα ἐστίν …",
      "en": "the children are … (singular verb!)"
     }
    ]
