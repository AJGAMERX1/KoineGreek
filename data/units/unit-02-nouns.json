  {
   "id": "u02-prepositions",
   "type": "grammar",
   "label": "ἐν ἐκ εἰς",
   "sub": "Prepositions and the cases they take",
   "drills": [
    "gloss-mc",
    "gloss-type",
    "form-recognition",
    "parse",
    "supply-form"
   ],
   "rule": {
    "title": "A preposition's meaning depends on the case after it",
    "body": "ἐν, σύν take the dative; εἰς takes the accusative; ἐκ, ἀπό, πρό take the genitive. Several prepositions change meaning with case: διά + genitive = through, διά + accusative = because of; μετά + genitive = with, μετά + accusative = after; ὑπό + genitive = by, ὑπό + accusative = under.",
    "examples": [
     {
      "gr": "ἐκ τοῦ κόσμου",
      "en": "out of the world"
     },
     {
      "gr": "διὰ τοῦ προφήτου",
      "en": "through the prophet"
     },
     {
      "gr": "μετὰ τρεῖς ἡμέρας",
      "en": "after three days"
     }
    ]
   },
