   "rule": {
    "title": "Three jobs",
    "body": "With the article, a participle describes a noun (ὁ ἄνθρωπος ὁ πιστεύων, the man who believes) or is itself a noun (ὁ πιστεύων, the believer). Without the article it modifies the action of the main verb: 'while / because / after doing X'. English needs a whole clause for what Greek does in one word.",
    "examples": [
     {
      "gr": "λέγοντες",
      "en": "saying (introducing a quotation)"
     },
     {
      "gr": "ἀκούσαντες δὲ",
      "en": "and when they heard"
     },
     {
      "gr": "τοῖς πιστεύουσιν",
      "en": "to those who believe"
     }
    ]
   },
