  {
   "id": "u08-conditionals",
   "type": "grammar",
   "label": "εἰ ἐάν",
   "sub": "Conditional sentences and the optative",
   "drills": [
    "gloss-mc",
    "gloss-type",
    "form-recognition",
    "parse",
    "supply-form"
   ],
   "rule": {
    "title": "Four kinds of 'if'",
    "body": "First class: εἰ + indicative, assumed true for argument's sake ('if, as is the case'). Second class: εἰ + past indicative with ἄν in the conclusion, contrary to fact ('if it were'). Third class: ἐάν + subjunctive, open possibility. Fourth class: εἰ + optative, remote wish (rare; the optative survives mostly in μὴ γένοιτο, 'may it never be!').",
    "examples": [
     {
      "gr": "εἰ υἱὸς εἶ τοῦ θεοῦ",
      "en": "if you are the Son of God"
     },
     {
      "gr": "εἰ ἦς ὧδε, οὐκ ἂν ἀπέθανεν",
      "en": "if you had been here, he would not have died"
     },
     {
      "gr": "ἐὰν ὁμολογῶμεν",
      "en": "if we confess"
     }
    ]
   },
