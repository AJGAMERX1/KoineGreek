  {
   "id": "u08-mi-verbs",
   "type": "verb",
   "label": "δίδωμι",
   "sub": "The -μι verbs",
   "drills": [
    "gloss-mc",
    "gloss-type",
    "form-recognition",
    "parse",
    "supply-form",
    "principal-parts"
   ],
   "rule": {
    "title": "Endings without a connecting vowel",
    "body": "A small, ancient group (δίδωμι give, τίθημι put, ἵστημι stand, ἀφίημι forgive/leave) adds endings straight to the stem: -μι -ς -σι -μεν -τε -ασι, with reduplication in ι in the present (δί-δωμι). Their aorists use κα (ἔδωκα, ἔθηκα, ἀφῆκα). Their compounds are extremely common: παραδίδωμι hand over, ἀνίστημι rise.",
    "examples": [
     {
      "gr": "δίδωσιν αὐτοῖς",
      "en": "he gives to them"
     },
     {
      "gr": "ἔδωκεν τὸν υἱόν",
      "en": "he gave the Son"
     },
     {
      "gr": "ἀφέωνταί σου αἱ ἁμαρτίαι",
      "en": "your sins are forgiven"
     }
    ]
   },
